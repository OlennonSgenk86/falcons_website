---
import '@fontsource/league-spartan/latin-700.css';
import '@fontsource/league-spartan/latin-800.css';
import '@fontsource/roboto/latin-400.css';
import '@fontsource/roboto/latin-500.css';
import { content } from '../data/content';
import { links, socialLinks } from '../data/links';
import Photo from './Photo.astro';
import InlineText from './InlineText.astro';
import Arrow from './Arrow.astro';
import Shop from './Shop.astro';
import { Image } from 'astro:assets';
import sparkLogo from '../assets/sponsors/spark.png';
import { media, mediaText } from '../data/media';
import './styles.css';
import './variants.css';
import { designs, type Theme } from '../data/designs';
const {lang = 'de',theme = 'dark'} = Astro.props as {lang:'de'|'it',theme:Theme};
const t = content[lang];
const mt = mediaText[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const menuTargets = ['#verein', '#angebote', links.registration!, '#onlineshop', '#kontakt', '#faq'];
---
<!doctype html>
<html lang={lang}>
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{t.title} | HC Falcons Brixen</title><meta name="description" content={t.description}/><meta name="robots" content="noindex, nofollow"/><meta name="theme-color" content="#CC1417"/><link rel="alternate" hreflang="de" href={`${base}de/${theme}/`}/><link rel="alternate" hreflang="it" href={`${base}it/${theme}/`}/></head>
<body class={theme}>
<a class="skip" href="#inhalt">{t.skip}</a>
<header class="header"><a href="#inhalt" class="brand" aria-label="HC Falcons Brixen"><Image class="club-logo" src={media.logo} alt="" width={64} height={64} format="png" loading="eager" /><span>HC FALCONS<small>BRIXEN · BRESSANONE</small></span></a><nav aria-label={lang==='de'?'Hauptnavigation':'Navigazione principale'}><ul>{t.nav.map((name,i)=><li><a href={menuTargets[i]}>{name}</a></li>)}</ul></nav><div class="header-actions"><a class="button small" href="#angebote">{t.join} <span aria-hidden="true"><svg class="arrow-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.5"/></svg></span></a><div class="languages" aria-label={lang==='de'?'Sprache':'Lingua'}><a href={`${base}de/${theme}/`} aria-current={lang==='de'?'page':undefined}>DE</a><span>/</span><a href={`${base}it/${theme}/`} aria-current={lang==='it'?'page':undefined}>IT</a></div></div></header>
<main id="inhalt">
<section class="hero"><div class="hero-content"><p class="eyebrow"><span></span>{t.eyebrow}</p><h1>{t.hero[0]}<br/>{t.hero[1]}<br/><em>{t.hero[2]}</em></h1><p class="intro">{t.intro}</p><div class="hero-buttons"><a class="button" href="#angebote">{t.cta}<span aria-hidden="true"><svg class="arrow-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.5"/></svg></span></a><a class="text-link" href="#einstieg">{t.secondary}<span aria-hidden="true">↓</span></a></div><div class="hero-bottom"><span class="mini-line"></span>{t.scroll}<span aria-hidden="true">↓</span></div></div><div class="hero-visual"><Photo src={media.hero} alt={mt.hero} kind="hero-photo" priority />{theme === 'spirit' && <div class="hero-collage"><div class="collage-community"><Photo src={media.family} alt={mt.family}/></div><div class="collage-entry"><Photo src={media.entry} alt={mt.entry}/></div></div>}<span class="vertical-label" aria-hidden="true">PASSION. TEAM. FALCONS.</span><div class="visual-stamp" aria-hidden="true">BE PART<br/>OF THE<br/><b>TEAM.</b></div></div></section>
<section id="angebote" class="offers section" aria-labelledby="offers-title">
 <div class="section-top"><div><p class="eyebrow">01 / {t.offersLabel}</p><h2 id="offers-title">{t.offersTitle}</h2></div><p>{t.offersIntro}</p></div>
 <div class="offer-feature"><div class="offer-feature-visual"><Photo src={media.entry} alt={mt.entry} kind="offer-feature-photo"/><p class="offer-photo-caption">{t.offerPhotoCaption}</p></div><div class="offer-grid">{t.offers.map((offer,i) => <article class:list={['offer-card', {'hockey-offer': i === 1}]}>
  <p class="offer-badge">{offer.badge}</p><h3>{offer.title}</h3>{'text' in offer && <p>{offer.text}</p>}
  {i === 1 && <dl class="offer-costs"><div><dt>{t.participationLabel}</dt><dd><InlineText text={t.participationText} registrationLabel={lang === 'de' ? 'Anmeldungen' : 'iscrizioni'}/></dd></div><div><dt>{t.equipmentLabel}</dt><dd>{t.equipmentText}</dd></div></dl>}
  <div class="offer-actions"><a class="button" href={links.registration!}>{offer.action}<Arrow/></a>{'trial' in offer && <a class="trial-link" href="mailto:info@hc-falcons.it">{offer.trial}<Arrow/></a>}</div>
 </article>)}</div></div>
</section>
<section class="why section" aria-labelledby="why-title"><div class="section-top"><div><p class="eyebrow">{t.whyLabel}</p><h2 id="why-title">{t.whyTitle}</h2></div><p>{t.whyIntro}</p></div><div class="benefits">{t.benefits.map(([number,title,text]) => <article><span class="number">{number}<Arrow/></span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
<section id="einstieg" class="path section"><div class="path-visual"><Photo src={media.entry} alt={mt.entry} kind="entry-photo" /><span class="image-index" aria-hidden="true">01 — START SMALL. DREAM BIG.</span></div><div class="path-content"><p class="eyebrow">02 / {t.pathLabel}</p><h2>{t.pathTitle}</h2><p>{t.pathIntro}</p><ol class="steps">{t.steps.map(([title,text],i)=><li><span>0{i+1}</span><div><h3>{title}</h3><p><InlineText text={text}/></p></div></li>)}</ol><div class="entry-actions"><p>{t.entryActionsHint}</p><div><a class="button" href={links.registration!}>{t.entryRegister}<Arrow/></a><a class="entry-mail" href="mailto:info@hc-falcons.it">{t.entryMail}<Arrow/></a></div></div></div></section>
<section id="verein" class="family section"><div class="family-copy"><p class="eyebrow">03 / {t.familyLabel}</p><h2>{t.familyTitle}</h2><p>{t.familyText}</p><div class="club-facts"><h3>{t.categoriesLabel}</h3><p class="categories">{t.categories}</p><p>{t.categoriesText}</p><p>{t.cooperation}</p></div><div class="club-support"><h3>{t.supportTitle}</h3><p>{t.supportText}</p></div></div><div><Photo src={media.family} alt={mt.family} kind="family-photo"/></div></section>
<section class="gallery section" aria-labelledby="gallery-title"><div class="section-top"><div><p class="eyebrow">{mt.galleryLabel}</p><h2 id="gallery-title">{mt.galleryTitle}</h2></div></div><div class="gallery-grid">{[media.practice, media.coach, media.fans, media.team].map((src,i) => <figure><Photo src={src} alt={mt.gallery[i][1]} kind={`gallery-photo gallery-photo-${i}`} /><figcaption>{mt.gallery[i][0]}</figcaption></figure>)}</div></section>
<Shop lang={lang} />
<section id="faq" class="faq section"><div><p class="eyebrow">04 / {t.faqLabel}</p><h2>{t.faqTitle}</h2><p>{t.faqIntro}</p><span class="faq-mark" aria-hidden="true">?</span></div><div class="questions">{t.faqs.map(([q,a],i)=><details><summary><span class="faq-number">0{i+1}</span>{q}<span class="plus" aria-hidden="true"></span></summary><p><InlineText text={a} registrationLabel={lang === 'de' ? 'Anmeldungen' : 'iscrizioni'}/></p></details>)}</div></section>
<section id="kontakt" class="contact section"><div><p class="eyebrow">05 / {t.contactLabel}</p><h2>{t.contactTitle}</h2><p>{t.contactText}</p><a class="button contact-registration" href={links.registration!}>{t.contactAction}<Arrow/></a></div><div class="contact-card"><p class="eyebrow">{t.contactMailLabel}</p><a class="contact-email" href="mailto:info@hc-falcons.it">info@hc-falcons.it</a><p>{t.contactHint}</p></div><span class="contact-word" aria-hidden="true">FALCONS</span></section>
<aside id="hauptsponsor" class="sponsors section main-sponsor" aria-label={t.sponsor}><p class="eyebrow">{t.sponsor}</p><Image class="sponsor-logo" src={sparkLogo} alt="Spark" width={200} height={200} format="webp" loading="lazy" /></aside>
</main>
<footer class="footer section"><div class="footer-top"><a class="brand" href="#inhalt"><Image class="club-logo" src={media.logo} alt="" width={64} height={64} format="png" loading="eager" /><span>HC FALCONS<small>BRIXEN · BRESSANONE</small></span></a><p>{t.footerLine}</p><div class="footer-contact"><a href="mailto:info@hc-falcons.it">info@hc-falcons.it</a><nav class="social-links" aria-label={t.social}>{socialLinks.map(social => <a href={social.url}>{social.label}<Arrow/></a>)}</nav></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} HC Falcons Brixen · {t.prototype}</span><div>{links.registration && <a href={links.registration}>{t.registration}</a>}{links.shop && <a href={links.shop}>{t.shop}</a>}<a href="#impressum">{t.legal}</a><a href="#datenschutz">{t.privacy}</a><a href="#inhalt" aria-label={lang==='de'?'Nach oben':'Torna su'}>↑</a></div></div><div class="legal-note" id="impressum"><h3>{t.legal}</h3><p>{t.legalText}</p></div><div class="legal-note" id="datenschutz"><h3>{t.privacy}</h3><p>{t.legalText}</p></div></footer>
{(theme === 'power' || theme === 'spirit') && <nav class="design-switch" aria-label={lang === 'de' ? 'Designvarianten vergleichen' : 'Confronta le varianti'}><a class="compare-home" href={`${base}designs/`}>{lang === 'de' ? 'Designs' : 'Design'}</a>{designs.map(d => <a href={`${base}${lang}/${d.key}/`} aria-current={theme === d.key ? 'page' : undefined}>{d.label}</a>)}</nav>}
</body></html>
