---
import { links } from '../data/links';
const { text, registrationLabel } = Astro.props as { text: string; registrationLabel?: string };
const email = 'info@hc-falcons.it';
const labels = registrationLabel ? [email, registrationLabel] : [email];
const pattern = new RegExp(`(${labels.map(label => label.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'g');
const parts = text.split(pattern);
---
{parts.map(part => part === email
 ? <a class="inline-email" href={`mailto:${email}`}>{part}</a>
 : registrationLabel && part === registrationLabel
 ? <a class="inline-email" href={links.registration!}>{part}</a>
 : part)}
