---
import { Image } from 'astro:assets';
import Arrow from './Arrow.astro';
import { content } from '../data/content';
import { links } from '../data/links';
import { shopProducts } from '../data/shop';
const { lang } = Astro.props as {lang: 'de' | 'it'};
const t = content[lang];
---
<section id="onlineshop" class="shop section" aria-labelledby="shop-title">
 <div class="section-top"><div><p class="eyebrow">{t.shopLabel}</p><h2 id="shop-title">{t.shopTitle}</h2></div><div class="shop-intro"><p>{t.shopText}</p><a class="text-link" href={links.shop!}>{t.shopAction}<Arrow/></a></div></div>
 <p id="shop-scroll-hint" class="shop-scroll-hint">{t.shopScroll}<span aria-hidden="true">↔</span></p>
 <ul class="shop-slider" tabindex="0" aria-label={t.shopLabel} aria-describedby="shop-scroll-hint">
  {shopProducts.map(product => <li class="shop-item"><a href={links.shop!}><div class="shop-product-image">
   <Image class:list={{'shop-wide-image': product.image.width / product.image.height > 1.4}} src={product.image} width={640} widths={[320, 640]} sizes="(max-width: 760px) 82vw, 39vw" format="webp" alt={`${product[lang]} · HC Falcons`} loading="lazy" />
  </div><div class="shop-item-caption"><h3>{product[lang]}</h3><Arrow/></div></a></li>)}
 </ul>
 <a class="button shop-main-link" href={links.shop!}>{t.shopAction}<Arrow/></a>
</section>
