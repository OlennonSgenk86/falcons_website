---
import '@fontsource/league-spartan/latin-700.css';
import '@fontsource/league-spartan/latin-800.css';
import '@fontsource/roboto/latin-400.css';
import { imprint } from '../data/imprint';
import { contact } from '../data/links';
import { isLive, liveOrigin, homePath } from '../data/site';
const { lang } = Astro.props as {lang:'de'|'it'};
const t = imprint[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const paths = {de:'de/impressum/',it:'it/note-legali/'};
const privacyPath = lang === 'de' ? 'de/datenschutz/' : 'it/privacy/';
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content={isLive?'index, follow':'noindex, nofollow'}/><meta name="description" content={`${t.title} – Hockey Club FALCONS Brixen`}/><title>{t.title} | HC Falcons Brixen</title>{isLive && <link rel="canonical" href={`${liveOrigin}${base}${paths[lang]}`}/>}<link rel="alternate" hreflang="de" href={`${base}${paths.de}`}/><link rel="alternate" hreflang="it" href={`${base}${paths.it}`}/></head><body><header><a href={homePath(lang)}>HC FALCONS BRIXEN</a><nav aria-label={lang==='de'?'Sprache':'Lingua'}><a href={`${base}${paths.de}`} aria-current={lang==='de'?'page':undefined}>DE</a><a href={`${base}${paths.it}`} aria-current={lang==='it'?'page':undefined}>IT</a></nav></header><main><a class="back" href={homePath(lang)}>← {t.back}</a><h1>{t.title}</h1><section><h2>{t.club}</h2><address>{t.address.map(line => <>{line}<br/></>)}</address><p>{t.representative}: Alex Gusella</p><h2>{t.contact}</h2><p>{t.contactPerson}: {contact.person}<br/><a href={`tel:${contact.phone}`}>{contact.phone}</a><br/><a href="mailto:info@hc-falcons.it">info@hc-falcons.it</a><br/><a href="https://www.hc-falcons.it/">www.hc-falcons.it</a></p></section>{t.sections.map(section => <section><h2>{section.title}</h2>{section.paragraphs.map(text => <p>{text}</p>)}</section>)}<section><h2>{t.privacyLabel}</h2><p>{t.privacy}</p><a href={`${base}${privacyPath}`}>{t.privacyLabel}</a></section></main><footer><a href={homePath(lang)}>{t.back}</a><span>© Hockey Club FALCONS Brixen</span></footer></body></html>
<style is:global>
*{box-sizing:border-box}body{margin:0;color:#172027;background:#f5f3ed;font-family:Roboto,sans-serif}a{color:inherit;text-underline-offset:4px}a:focus-visible{outline:3px solid #cc1417;outline-offset:4px}header{display:flex;justify-content:space-between;gap:20px;background:#172027;color:#fff;padding:28px 7%}header>a{font:800 22px 'League Spartan',sans-serif;text-decoration:none}nav{display:flex;gap:20px;font-size:12px}nav a{text-decoration:none}nav a[aria-current]{text-decoration:underline}main{max-width:920px;margin:auto;padding:45px 35px 65px}.back{display:inline-block;font-size:12px;margin-bottom:35px}h1{font:800 clamp(40px,6vw,65px)/1 'League Spartan',sans-serif;letter-spacing:-.035em;margin:0 0 35px}h2{font:700 27px/1.15 'League Spartan',sans-serif;letter-spacing:-.025em;margin:0 0 18px}section{border-top:1px solid #d0d5cb;padding-top:27px;margin-top:27px}p,address{font-size:14px;line-height:1.85;margin:0 0 20px}address{font-style:normal}footer{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;padding:30px 7%;background:#172027;color:#fff;font-size:12px}@media(max-width:600px){main{padding:35px 6% 50px}header{padding:22px 6%}header>a{font-size:19px}h2{font-size:25px}}
</style>
