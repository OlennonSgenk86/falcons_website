---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; kind?: string; priority?: boolean; }
const { src, alt, kind = '', priority = false } = Astro.props;
---
<div class:list={['photo', kind]}>
 <Image src={src} alt={alt} width={1440} widths={[400, 640, 960, 1440]} sizes={kind.startsWith("gallery") ? "(max-width: 760px) 42vw, (max-width: 1150px) 43vw, 21vw" : "(max-width: 760px) 88vw, 48vw"} format="webp" quality={80} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
</div>
