---
import Favicon from './Favicon.astro';
import '@fontsource/league-spartan/latin-700.css';
import '@fontsource/league-spartan/latin-800.css';
import '@fontsource/roboto/latin-400.css';
import { Image } from 'astro:assets';
import { media } from '../data/media';
import { privacy } from '../data/privacy';
import { contact } from '../data/links';
import { isLive, liveOrigin, homePath } from '../data/site';
import InlineText from './InlineText.astro';
const { lang } = Astro.props as { lang: 'de'|'it' };
const t = privacy[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const isPages = process.env.GITHUB_PAGES === 'true';
const paths = { de: 'de/datenschutz/', it: 'it/privacy/' };
---
<!doctype html><html lang={lang}><head><Favicon/><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content={isLive ? "index, follow" : "noindex, nofollow"}/>{isLive && <link rel="canonical" href={`${liveOrigin}${base}${paths[lang]}`}/>}<meta name="description" content={t.subtitle}/><title>{t.title} | HC Falcons Brixen</title><link rel="alternate" hreflang="de" href={`${base}${paths.de}`}/><link rel="alternate" hreflang="it" href={`${base}${paths.it}`}/></head><body>
<header><a class="brand" href={homePath(lang)}><Image src={media.logo} width={50} height={50} alt=""/><span>HC FALCONS<small>BRIXEN · BRESSANONE</small></span></a><nav aria-label={t.language}><a href={`${base}${paths.de}`} aria-current={lang==='de'?'page':undefined}>DE</a><a href={`${base}${paths.it}`} aria-current={lang==='it'?'page':undefined}>IT</a></nav></header>
<main><a class="back" href={homePath(lang)}>← {t.back}</a><p class="eyebrow">HC FALCONS BRIXEN</p><h1>{t.title}</h1><p class="subtitle">{t.subtitle}</p><p class="updated">{t.updated}</p>
{!isLive && <aside class="review"><h2>{t.reviewTitle}</h2><p>{t.reviewText}</p></aside>}
{t.sections.map((section,i) => <><section><h2>{section.title}</h2>{section.paragraphs.map(text => <p><InlineText text={text}/></p>)}{i === 0 && <p>{lang === 'de' ? 'Ansprechperson' : 'Referente'}: {contact.person} · <a href={`tel:${contact.phone}`}>{contact.phone}</a></p>}</section>{i===2 && <section class="hosting"><h2>{t.hostingTitle}</h2><p>{isPages ? t.github : t.production}</p>{isPages && <><p><a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">{t.githubLink}</a></p><p>{t.production}</p></>}</section>}</>)}
<div class="resources"><a href="https://www.garanteprivacy.it/">{t.authorityLink}</a><a href={lang==='de'?'https://eur-lex.europa.eu/eli/reg/2016/679/oj?locale=de':'https://eur-lex.europa.eu/eli/reg/2016/679/oj?locale=it'}>{t.regulationLink}</a></div>
</main><footer><a href={homePath(lang)}>{t.back}</a><a href="mailto:info@hc-falcons.it">info@hc-falcons.it</a><a href={`tel:${contact.phone}`}>{contact.phone} · {contact.person}</a></footer>
</body></html>
<style is:global>
*{box-sizing:border-box}html{color:#172027;background:#f5f3ed;font-family:Roboto,sans-serif}body{margin:0}a{color:inherit;text-underline-offset:4px}a:focus-visible{outline:3px solid #cc1417;outline-offset:4px}header{display:flex;justify-content:space-between;align-items:center;padding:22px 7%;background:#172027;color:#fff;gap:20px}.brand{display:flex;align-items:center;gap:12px;text-decoration:none;font:800 24px 'League Spartan',sans-serif}.brand img{display:block}.brand small{display:block;font:8px Roboto,sans-serif;letter-spacing:.16em;margin-top:5px}header nav{display:flex;gap:18px;font-size:12px}header nav a{text-decoration:none}header nav a[aria-current]{text-decoration:underline}main{max-width:920px;padding:55px 35px 75px;margin:0 auto}.back{display:inline-block;font-size:12px;margin-bottom:40px}.eyebrow{font-size:10px;letter-spacing:.15em;color:#cc1417;margin-bottom:15px}h1{font:800 clamp(36px,5vw,62px)/1.02 'League Spartan',sans-serif;letter-spacing:-.035em;margin:0 0 22px;overflow-wrap:anywhere}.subtitle{font-size:17px;color:#535d5b;line-height:1.7}.updated{font-size:12px;color:#626c67;margin-bottom:30px}h2{font:700 27px/1.12 'League Spartan',sans-serif;letter-spacing:-.02em;margin:0 0 15px}section{padding-top:30px;margin-top:30px;border-top:1px solid #d0d5cb}p{font-size:14px;line-height:1.85;margin:0 0 16px}.review{border-left:4px solid #cc1417;background:#fff;padding:25px;margin-bottom:30px}.review h2{font-size:23px}.review p{font-size:13px;margin-bottom:0}.hosting{padding:25px;background:#e8e9e1;border:0}.resources{display:flex;flex-wrap:wrap;gap:20px;font-size:12px;margin-top:35px}footer{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;background:#172027;color:white;padding:30px 7%;font-size:12px}@media(max-width:600px){header{padding:18px 6%}.brand{font-size:19px}.brand img{width:40px;height:40px}main{padding:35px 6% 50px}h2{font-size:25px}.review{padding:20px}.hosting{padding:20px}.back{margin-bottom:30px}}
</style>
