---
import { Image } from 'astro:assets';
import '@fontsource/league-spartan/latin-700.css';
import '@fontsource/league-spartan/latin-800.css';
import '@fontsource/roboto/latin-400.css';
import { designs } from '../data/designs';
import darkPreview from '../../docs/previews/Variante-A-Dark-Athletic-Hero.png';
import powerPreview from '../../docs/previews/Variante-C-Power-Play-Hero.png';
import spiritPreview from '../../docs/previews/Variante-D-Team-Spirit-Hero.png';
const previews = [darkPreview, powerPreview, spiritPreview];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html><html lang="de"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><meta name="description" content="Die bisherige Falcons-Website und zwei neue Designrichtungen im direkten Vergleich."/><title>Designvergleich | HC Falcons Brixen</title></head>
<body><header><a href={`${base}de/dark/`}>HC FALCONS <span>BRIXEN · BRESSANONE</span></a><p>DESIGNSTUDIO / 03 RICHTUNGEN</p></header><main><p class="eyebrow">EIN VEREIN. DREI AUFTRITTE.</p><h1>Mehr Gefühl.<br/>Mehr Falcons.</h1><p class="intro">Die Inhalte stehen. Jetzt geht es um den Auftritt: Vergleicht die bisherige Gestaltung mit zwei neuen Richtungen. Jede Variante ist auf Deutsch und Italienisch klickbar.</p><div class="cards">{designs.map((design,i) => <article><a class="preview" href={`${base}de/${design.key}/`} aria-label={`${design.label} auf Deutsch öffnen`}><Image src={previews[i]} width={800} format="webp" alt={`Desktop-Vorschau ${design.label}`} loading={i === 0 ? 'eager' : 'lazy'}/></a><div class="card-copy"><p class="tag">{design.key === 'power' ? 'AKTUELL AUSGEWÄHLT' : i === 0 ? 'BISHERIGE VARIANTE' : 'WEITERE ALTERNATIVE'}</p><h2>{design.label}</h2><p>{design.description}</p><div class="actions"><a href={`${base}de/${design.key}/`}>Deutsch ansehen <span aria-hidden="true">↗</span></a><a class="italian" href={`${base}it/${design.key}/`}>Italiano</a></div></div></article>)}</div><p class="note">Originalbilder, Texte, Anmeldungen, Shop und Hauptsponsor bleiben in allen Richtungen erhalten.</p></main></body></html>
<style is:global>
*{box-sizing:border-box}body{margin:0;background:#11191f;color:#fff;font-family:Roboto,sans-serif}a{color:inherit;text-decoration:none}a:focus-visible{outline:3px solid #fff;outline-offset:5px}header{padding:30px 6%;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #ffffff20;gap:20px}header>a{font:800 24px 'League Spartan',sans-serif}header>a>span{display:block;font:9px Roboto,sans-serif;letter-spacing:.18em;margin-top:6px}header>p{font-size:10px;letter-spacing:.16em;color:#bec6c8}main{padding:65px 6% 50px;max-width:1800px;margin:auto}.eyebrow{color:#fff;font-size:10px;letter-spacing:.18em;border-left:25px solid #cc1417;padding-left:13px;margin:0 0 25px}h1{font:800 clamp(55px,6vw,90px)/.94 'League Spartan',sans-serif;letter-spacing:-.04em;margin:0}.intro{color:#c0c8c9;font-size:15px;line-height:1.8;max-width:640px;margin:25px 0 45px}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}article{background:#fff;color:#172027;min-width:0}.preview{display:block;border-bottom:1px solid #ddd;overflow:hidden}.preview img{display:block;width:100%;height:auto;aspect-ratio:1.44;object-fit:cover;object-position:top}.card-copy{padding:25px}.tag{font-size:9px;color:#cc1417;letter-spacing:.14em;margin:0 0 15px}h2{font:800 36px 'League Spartan',sans-serif;letter-spacing:-.035em;margin:0 0 10px}.card-copy>p:not(.tag){font-size:13px;line-height:1.7;color:#62676b}.actions{display:flex;align-items:center;gap:20px;justify-content:space-between;margin-top:25px;font-size:12px}.actions>a:first-child{background:#cc1417;color:white;padding:15px;display:flex;gap:20px;align-items:center}.actions .italian{text-decoration:underline;text-underline-offset:3px}.note{font-size:11px;color:#b6c0c2;margin-top:30px;line-height:1.8}@media(max-width:1000px){.cards{grid-template-columns:1fr;max-width:720px}.preview img{max-height:400px}.card-copy{padding:28px}header>p{display:none}main{padding-top:45px}.actions{justify-content:start;gap:30px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto}}
</style>
