---
import Favicon from '../components/Favicon.astro';
import { homePath } from '../data/site';
---
<!doctype html><html lang="de"><head><Favicon/><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex"/><title>Seite nicht gefunden | HC Falcons Brixen</title></head><body><main><p>HC FALCONS BRIXEN</p><h1>Diese Seite gibt es nicht mehr.</h1><p>Pagina non trovata.</p><a href={homePath('de')}>Zur Startseite</a><a href={homePath('it')}>Torna alla pagina iniziale</a></main></body></html>
<style is:global>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#172027;color:#fff;font:16px/1.6 system-ui,sans-serif}main{padding:40px;max-width:650px}h1{font-size:clamp(28px,5vw,48px);line-height:1.1}a{display:inline-block;margin:15px 20px 0 0;color:white;text-underline-offset:5px}a:focus-visible{outline:3px solid #cc1417;outline-offset:5px}</style>
